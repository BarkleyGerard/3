			<Item class="Script" referent="RBX3557A6D2E281482AA32CC9E0BACFB657">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- 23/5/2018 --
sp = script.Parent
creator = sp:WaitForChild("creator")
sp.Touched:Connect(function(hit)
	if hit and hit.Parent then
		local npc = hit.Parent
		local hum = npc:FindFirstChildOfClass('Humanoid')
		if hum then
			local root = npc:FindFirstChild('HumanoidRootPart')
			
			if root and npc~=creator.Value then
				root.Velocity = sp.CFrame.LookVector * 55
			end
			
			local sodatag = Instance.new("BoolValue")
			sodatag.Name = "soda'd"
			sodatag.Parent = npc
			game.Debris:AddItem(sodatag, 0.1)
		end
	end
end)
]]></ProtectedString>
