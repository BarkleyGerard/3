		<Item class="Script" referent="RBX1CDF90C5A3AB456E8FC695FF774CEA02">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- 23/5/2018 --
-- CAN'T USE PHYSICSSERVICE ON CAN'T COLLIDE PART! --
-- 26/5/2018 --
-- 27/5/2018: if the spill is too THICC then it will push people even harder --
remote = script.Parent:WaitForChild("SodaRemote")
tool = script.Parent

remote.OnServerInvoke = function(plr, torso)
	-- let the principal knows that you are drinking in halls  26/5/2018 --
	local drinktag = Instance.new("BoolValue")
	drinktag.Name = 'drinking'
	drinktag.Parent = plr.Character
	game.Debris:AddItem(drinktag, 1)
	
	local spill = Instance.new("Part")
	spill.Name = 'Bloxy Spill'
	spill.Size = Vector3.new(12,12,.5)
	spill.Transparency = 1
	spill.CFrame = torso.CFrame * CFrame.new(0,2,-3)
	spill.CanCollide = false -- will be changed in the next step
	
	local bill = Instance.new("BillboardGui")
	bill.Size = UDim2.new(10,0,10,0)
	bill.Parent = spill
	local imglab = Instance.new("ImageLabel")
	imglab.BackgroundTransparency = 1
	imglab.Size = UDim2.new(1,0,1,0)
	
	
	if script.Parent:FindFirstChild("OldSplitSprite") ~= nil then
		if script.Parent:FindFirstChild('OldSplitSprite').Value == false then
			imglab.Image = 'http://www.roblox.com/asset/?id=16620307744'
			if script.Parent:FindFirstChild('Spinning') ~= nil then
				local spn = script.Parent:FindFirstChild('Spinning'):Clone()
				spn.Parent = imglab
				spn.Enabled = true
			end
		else
			imglab.Image = 'http://www.roblox.com/asset/?id=16539171436'
		end
	else
		imglab.Image = 'http://www.roblox.com/asset/?id=16539171436'
	end
	imglab.Parent = bill
	imglab.ResampleMode = Enum.ResamplerMode.Pixelated
	
	local tag = Instance.new("ObjectValue")
	tag.Name = 'creator'
	tag.Value = plr.Character
	tag.Parent = spill
	
	spill.Parent = workspace
	game.Debris:AddItem(spill, 10)
	
	local bv = Instance.new("BodyVelocity")
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Velocity = ((torso.CFrame * CFrame.new(0,0,-5)).p - torso.CFrame.p).unit * 20 -- lookVector doesn't work? 23/5/2018
	bv.Parent = spill
	local gyro = Instance.new"BodyGyro"
	gyro.MaxTorque = Vector3.new(math.huge,math.huge,math.huge)
	gyro.CFrame = spill.CFrame
	gyro.Parent = spill
	
	
	--coroutine.resume(coroutine.create(function()
	--	while wait() do
	--		--spill.CFrame = spill.CFrame * CFrame.Angles(0, math.rad(10), 0)
	--		imglab.Rotation = imglab.Rotation + 10
	--	end
	--end))
	
	local sodascr = script.SodaPush:Clone()
	sodascr.Parent = spill
	sodascr.Disabled = false
	
	if tool.ToolRemove.Value == true then
	tool:Destroy()
	end
	
	return spill
end
]]></ProtectedString>
				<bool name="Disabled">false</bool>
