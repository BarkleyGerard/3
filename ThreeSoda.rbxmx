		<Item class="LocalScript" referent="RBX0D47D2DA303F4F49B196175E7151437B">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- 22/5/2018 --
-- 25/5/2018 --
plr = game.Players.LocalPlayer
tool = script.Parent
handle = tool:WaitForChild("Handle")
remote = script.Parent:WaitForChild("SodaRemote")
mouse = plr:GetMouse()
tool.Activated:Connect(function()
	local torso = plr.Character:FindFirstChild("HumanoidRootPart")
	if torso then
	remote:InvokeServer(torso) -- most of the soda system is in the remote script
	handle.Splat:Play()
	end
end)

]]></ProtectedString>
